# Copy this file to `.env` and fill in your Alpaca PAPER trading credentials.
# `.env` is gitignored; never commit your real keys.
#
# Get keys at: https://app.alpaca.markets/paper/dashboard/overview
# (top-right "View" or "Generate New Key" in the API Keys panel)

ALPACA_API_KEY=PK_your_paper_key_id_here
ALPACA_API_SECRET=your_paper_secret_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Optional: webhook for ERROR-level log alerts (Slack/Discord/etc.)
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...
